# SHEKU local development example.
#
# The industrial_ai identifiers below are retained as internal technical
# namespaces retained for backward compatibility. They are not the product brand.
# Do not reuse these sample credentials or local security defaults in production.

POSTGRES_USER=industrial_ai
POSTGRES_PASSWORD=industrial_ai
POSTGRES_DB=industrial_ai
DATABASE_URL=postgresql+psycopg://industrial_ai:industrial_ai@localhost:5432/industrial_ai

IDENTITY_POSTGRES_USER=industrial_ai_identity
IDENTITY_POSTGRES_PASSWORD=identity_local_only
IDENTITY_POSTGRES_DB=industrial_ai_identity
IDENTITY_POSTGRES_PORT=5433
IDENTITY_DATABASE_URL=postgresql+psycopg://industrial_ai_identity:identity_local_only@localhost:5433/industrial_ai_identity
CONTAINER_IDENTITY_DATABASE_URL=postgresql+psycopg://industrial_ai_identity:identity_local_only@identity-postgres:5432/industrial_ai_identity

AUTHENTICATION_REQUIRED=true
API_DOCS_ENABLED=false
AUTH_COOKIE_NAME=industrial_ai_session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_ABSOLUTE_SECONDS=43200
AUTH_SESSION_INACTIVITY_SECONDS=3600
AUTH_SESSION_TOUCH_INTERVAL_SECONDS=300
AUTH_ARGON2_TIME_COST=3
AUTH_ARGON2_MEMORY_COST_KIB=65536
AUTH_ARGON2_PARALLELISM=4
AUTH_ARGON2_HASH_LENGTH=32
AUTH_ARGON2_SALT_LENGTH=16
AUTH_PASSWORD_MIN_LENGTH=15
AUTH_PASSWORD_MAX_LENGTH=128
AUTH_PASSWORD_BLOCK_CONTEXT=true
AUTH_PASSWORD_BLOCK_COMMON=true
AUTH_ATTEMPT_WINDOW_SECONDS=900
AUTH_ATTEMPT_THRESHOLD=5
AUTH_ATTEMPT_BLOCK_BASE_SECONDS=30
AUTH_ATTEMPT_BLOCK_MAX_SECONDS=900
AUTH_CSRF_HEADER_NAME=X-CSRF-Token
AUTH_CSRF_TOKEN_BYTES=32

# Optional AI provider endpoint. SHEKU Core remains operational without it.
OLLAMA_BASE_URL=http://localhost:11434

NEXT_PUBLIC_API_URL=http://localhost:8000
